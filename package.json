{
  "name": "political-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest",
    "verify": "npm run build && npm test && npm audit --audit-level=low",
    "verify:http": "node scripts/verify-local-http.mjs",
    "verify:email": "node scripts/verify-local-email.mjs",
    "deploy": "npm run build && wrangler deploy",
    "data:fec2026:dry-run": "node scripts/prepare-fec-2026-loader.mjs --dry-run",
    "data:fec2026:sql": "node scripts/prepare-fec-2026-loader.mjs",
    "data:governors2026:dry-run": "node scripts/prepare-governor-2026-loader.mjs --dry-run",
    "data:governors2026:sql": "node scripts/prepare-governor-2026-loader.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "itty-router": "^5.0.24",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "miniflare": {
      "undici": "7.30.0"
    }
  }
}
